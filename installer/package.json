{
  "name": "yapdev-installer",
  "version": "0.1.0",
  "description": "Installer for Yapdev",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "app.yapdev.installer",
    "productName": "Yapdev Installer",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "patcher.js",
      "index.html",
      "buildinfo.json",
      "bundle/**",
      "assets/**"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "YapdevInstaller.exe"
    }
  }
}